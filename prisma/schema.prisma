generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                @id @default(cuid())
  firstName                   String?
  lastName                    String?
  email                       String                @unique
  emailVerified               DateTime?
  image                       String?
  passwordHash                String
  role                        Role                  @default(STUDENT)
  tags                        String[]              @default([])
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  approved                    Boolean               @default(false)
  branchId                    String?
  accounts                    Account[]
  childrenAsParent            ParentChild[]         @relation("ParentChildParent")
  parentsAsChild              ParentChild[]         @relation("ParentChildChild")
  assignmentsAsStudent        Assignment[]          @relation("AssignmentStudent")
  assignmentsAsTeacher        Assignment[]          @relation("AssignmentTeacher")
  bookingsAsStudent           Booking[]             @relation("StudentBookings")
  bookingsAsTeacher           Booking[]             @relation("TeacherBookings")
  classEnrollments            ClassStudent[]
  classesTeaching             Class[]
  examsCreated                Exam[]
  notifications               Notification[]
  payments                    PaymentSchedule[]     @relation("StudentPayments")
  sessions                    Session[]
  enrollments                 StudentEnrollment[]   @relation("StudentEnrollments")
  studentProfile              StudentProfile?       @relation("StudentProfileUser")
  studentsTeaching            StudentProfile[]      @relation("TeacherOfStudent")
  teacherProfile              TeacherProfile?       @relation("TeacherProfileUser")
  tuitionPayments             TuitionPayment[]      @relation("StudentTuitionPayments")
  branch                      Branch?               @relation(fields: [branchId], references: [id])
  writingSubmissionsAsGrader  WritingSubmission[]   @relation("WritingGrader")
  writingSubmissionsAsStudent WritingSubmission[]   @relation("WritingStudent")
  writingSubmissionsAsTeacher WritingSubmission[]   @relation("WritingTeacher")
  lessonsCreated              Lesson[]              @relation("LessonCreator")
  lessonProgress              LessonProgress[]      @relation("StudentLessonProgress")
  wordListsCreated            WordList[]            @relation("WordListCreator")
  wordReviews                 WordReview[]          @relation("StudentWordReviews")
  tricksCreated               Trick[]               @relation("TrickCreator")
  trickSaves                  TrickSave[]           @relation("StudentTrickSaves")
  referralsAsPartner          Referral[]            @relation("PartnerReferrals")
  referralsAsStudent          Referral[]            @relation("StudentReferrals")
  referralsDecided            Referral[]            @relation("ReferralDecidedBy")
  scheduleSlots               ScheduleSlot[]        @relation("TeacherScheduleSlots")
  lessonSessions              LessonSession[]       @relation("TeacherLessonSessions")
  lessonRecordsAsStudent      LessonStudentRecord[] @relation("StudentLessonRecords")
  lessonRecordsAsTeacher      LessonStudentRecord[] @relation("TeacherLessonRecords")
  coinTransactionsAsStudent   CoinTransaction[]     @relation("StudentCoinTransactions")
  coinTransactionsCreated     CoinTransaction[]     @relation("CoinTransactionCreator")

  @@map("users")
}

model ParentChild {
  id        String   @id @default(cuid())
  parentId  String
  childId   String
  createdAt DateTime @default(now())

  parent User @relation("ParentChildParent", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ParentChildChild", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
  @@map("parent_children")
}

model Branch {
  id              String              @id @default(cuid())
  name            String              @unique
  createdAt       DateTime            @default(now())
  assignments     Assignment[]
  attempts        Attempt[]
  bookings        Booking[]
  classes         Class[]
  financeTxns     FinanceTxn[]
  payments        PaymentSchedule[]
  enrollments     StudentEnrollment[]
  studentProfiles StudentProfile[]
  tuitionPayments TuitionPayment[]
  users           User[]
  referrals       Referral[]          @relation("BranchReferrals")
  scheduleSlots   ScheduleSlot[]
  lessonSessions  LessonSession[]

  @@map("branches")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Class {
  id                 String                @id @default(cuid())
  name               String
  teacherId          String
  createdAt          DateTime              @default(now())
  branchId           String?
  assignments        Assignment[]
  classStudents      ClassStudent[]
  branch             Branch?               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  teacher            User                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  writingSubmissions WritingSubmission[]
  scheduleSlots      ScheduleSlot[]
  lessonSessions     LessonSession[]
  lessonRecords      LessonStudentRecord[]

  @@map("classes")
}

model ClassStudent {
  id        String   @id @default(cuid())
  classId   String
  studentId String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@map("class_students")
}

model Attempt {
  id             String           @id @default(cuid())
  status         String           @default("IN_PROGRESS")
  bandOverall    Float?
  createdAt      DateTime         @default(now())
  bookingId      String?          @unique
  startedAt      DateTime?
  submittedAt    DateTime?
  branchId       String?
  assignmentId   String?          @unique
  examId         String
  studentId      String
  answers        Json?
  sections         AttemptSection[]
  attemptAnswers   AttemptAnswer[]
  coinTransactions CoinTransaction[]
  assignment       Assignment?      @relation(fields: [assignmentId], references: [id])
  booking          Booking?         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  branch           Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([studentId, status])
  @@index([studentId, createdAt])
  @@index([status, createdAt])
  @@map("attempts")
}

model AttemptSection {
  id                String             @id @default(cuid())
  attemptId         String
  type              SectionType
  answers           Json?
  rawScore          Int?
  bandScore         Float?
  gradedById        String?
  rubric            Json?
  feedback          String?
  startedAt         DateTime?
  endedAt           DateTime?
  status            String             @default("IN_PROGRESS")
  maxScore          Int?
  attempt           Attempt            @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  writingSubmission WritingSubmission?

  @@index([attemptId, type])
  @@map("attempt_sections")
}

model AttemptAnswer {
  id         String      @id @default(cuid())
  attemptId  String
  section    SectionType
  questionId String
  answer     Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, section, questionId])
  @@index([attemptId, section])
  @@map("attempt_answers")
}

model WritingSubmission {
  id                String         @id @default(cuid())
  attemptSectionId  String         @unique
  attemptId         String
  studentId         String
  classId           String?
  teacherId         String?
  task1Response     String
  task2Response     String
  wordCountTask1    Int
  wordCountTask2    Int
  startedAt         DateTime
  submittedAt       DateTime
  timeSpentSeconds  Int
  overallBand       Float?
  task1Band         Float?
  task2Band         Float?
  overallComments   String?
  task1Comments     String?
  task2Comments     String?
  feedbackPublished Boolean        @default(false)
  gradedAt          DateTime?
  gradedById        String?
  aiTask1TR         Float?
  aiTask1CC         Float?
  aiTask1LR         Float?
  aiTask1GRA        Float?
  aiTask1Overall    Float?
  aiTask1Feedback   String?
  aiTask2TR         Float?
  aiTask2CC         Float?
  aiTask2LR         Float?
  aiTask2GRA        Float?
  aiTask2Overall    Float?
  aiTask2Feedback   String?
  aiScoredAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  attemptSection    AttemptSection @relation(fields: [attemptSectionId], references: [id], onDelete: Cascade)
  class             Class?         @relation(fields: [classId], references: [id])
  gradedBy          User?          @relation("WritingGrader", fields: [gradedById], references: [id])
  student           User           @relation("WritingStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher           User?          @relation("WritingTeacher", fields: [teacherId], references: [id])

  @@index([studentId, submittedAt])
  @@index([teacherId, submittedAt])
  @@index([classId, feedbackPublished])
  @@index([attemptId])
  @@map("writing_submissions")
}

model Exam {
  id              String           @id @default(cuid())
  title           String
  isActive        Boolean          @default(true)
  createdById     String?
  createdAt       DateTime         @default(now())
  category        ExamCategory     @default(IELTS)
  track           String?
  durationMin     Int?
  sectionPassword String?
  readingType     String?          @default("ACADEMIC")
  writingType     String?          @default("ACADEMIC")
  bookings        Booking[]
  assignments     ExamAssignment[]
  homeworkAssignments Assignment[] @relation("HomeworkExamAssignments")
  sections        ExamSection[]
  createdBy       User?            @relation(fields: [createdById], references: [id])
  questions       Question[]
  unitExams       UnitExam[]
  isHomework      Boolean          @default(false)
  homeworkSubject String?

  @@map("exams")
}

model Booking {
  id          String        @id @default(cuid())
  studentId   String
  teacherId   String?
  examId      String
  sections    SectionType[]
  startAt     DateTime
  status      String        @default("CONFIRMED")
  createdAt   DateTime      @default(now())
  reminded1h  Boolean       @default(false)
  reminded24h Boolean       @default(false)
  branchId    String?
  attempt     Attempt?
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     User          @relation("StudentBookings", fields: [studentId], references: [id], onDelete: Cascade)
  teacher     User?         @relation("TeacherBookings", fields: [teacherId], references: [id])

  @@index([studentId, startAt])
  @@index([teacherId, startAt])
  @@map("bookings")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  channel   String
  title     String
  body      String
  sentAt    DateTime?
  meta      Json?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model ExamSection {
  id              String        @id @default(cuid())
  examId          String
  type            SectionType
  durationMin     Int           @default(15)
  order           Float         @default(0)
  title           String
  instruction     Json?
  image           String?
  image2          String?
  parentSectionId String?       @map("parent_section_id")
  exam            Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  parentSection   ExamSection?  @relation("Subsections", fields: [parentSectionId], references: [id], onDelete: Cascade)
  subsections     ExamSection[] @relation("Subsections")
  questions       Question[]

  @@map("exam_sections")
}

model Question {
  id          String        @id @default(cuid())
  examId      String?
  prompt      Json
  options     Json?
  answerKey   Json?
  maxScore    Int           @default(1)
  order       Int
  explanation Json?
  sectionId   String
  qtype       QuestionType
  image       String? // For FILL_IN_BLANK and other question types
  tags        QuestionTag[]
  Exam        Exam?         @relation(fields: [examId], references: [id])
  section     ExamSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model BandMap {
  id       String      @id @default(cuid())
  examType String
  section  SectionType
  minRaw   Int
  maxRaw   Int
  band     Float

  @@map("band_maps")
}

model QuestionTag {
  id         String   @id @default(cuid())
  questionId String
  tag        String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([tag])
  @@index([questionId])
  @@map("question_tags")
}

model Track {
  id        String   @id @default(cuid())
  name      String   @unique
  kind      String   @default("GENERAL_ENGLISH")
  createdAt DateTime @default(now())
  books     Book[]

  @@map("tracks")
}

model Book {
  id        String   @id @default(cuid())
  title     String
  trackId   String?
  createdAt DateTime @default(now())
  track     Track?   @relation(fields: [trackId], references: [id])
  units     Unit[]

  @@map("books")
}

model Unit {
  id        String     @id @default(cuid())
  bookId    String
  title     String
  order     Int
  createdAt DateTime   @default(now())
  unitExams UnitExam[]
  book      Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("units")
}

model UnitExam {
  id          String       @id @default(cuid())
  unitId      String
  examId      String
  createdAt   DateTime     @default(now())
  assignments Assignment[]
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@map("unit_exams")
}

model Assignment {
  id         String    @id @default(cuid())
  unitExamId String?
  examId     String?
  studentId  String
  teacherId  String?
  classId    String?
  branchId   String?
  startAt    DateTime?
  dueAt      DateTime?
  status     String    @default("ASSIGNED")
  isExtra    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  class      Class?    @relation(fields: [classId], references: [id])
  student    User      @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher    User?     @relation("AssignmentTeacher", fields: [teacherId], references: [id])
  unitExam   UnitExam? @relation(fields: [unitExamId], references: [id], onDelete: Cascade)
  exam       Exam?     @relation("HomeworkExamAssignments", fields: [examId], references: [id], onDelete: Cascade)
  attempt    Attempt?

  @@index([studentId, startAt])
  @@index([teacherId, startAt])
  @@index([studentId, isExtra, status])
  @@index([examId])
  @@map("assignments")
}

model ExamAssignment {
  id          String        @id @default(cuid())
  studentId   String
  examId      String
  sections    SectionType[]
  startAt     DateTime?
  dueAt       DateTime?
  createdById String
  branchId    String?
  createdAt   DateTime      @default(now())
  exam        Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([studentId, examId])
  @@map("exam_assignments")
}

model StudentEnrollment {
  id               String            @id @default(cuid())
  studentId        String
  courseName       String
  courseType       String
  level            String?
  branchId         String?
  enrolledAt       DateTime          @default(now())
  status           String            @default("ACTIVE")
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  paymentSchedules PaymentSchedule[]
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  student          User              @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([branchId, status])
  @@map("student_enrollments")
}

model PaymentSchedule {
  id            String            @id @default(cuid())
  enrollmentId  String
  studentId     String
  amount        Decimal           @db.Decimal(10, 2)
  dueDate       DateTime
  paidDate      DateTime?
  status        String            @default("PENDING")
  paymentMethod String?
  notes         String?
  branchId      String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  enrollment    StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student       User              @relation("StudentPayments", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, dueDate])
  @@index([branchId, dueDate])
  @@index([status, dueDate])
  @@map("payment_schedules")
}

model FinanceTxn {
  id         String   @id @default(cuid())
  branchId   String?
  kind       String
  category   String
  amount     Decimal  @db.Decimal(10, 2)
  currency   String   @default("AZN")
  occurredAt DateTime
  meta       Json?
  createdAt  DateTime @default(now())
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId, occurredAt])
  @@index([kind, occurredAt])
  @@index([category, occurredAt])
  @@map("finance_txns")
}

model StudentProfile {
  id               String    @id @default(cuid())
  studentId        String    @unique
  branchId         String
  teacherId        String?
  firstEnrollAt    DateTime?
  monthlyFee       Decimal?  @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  dateOfBirth      DateTime?
  paymentAmount    Decimal?  @db.Decimal(10, 2)
  paymentDate      DateTime?
  phoneNumber      String?
  program          String?
  studyTypes       String[]  @default([])
  lessonModes      String[]  @default([])
  studentKind      String    @default("STUDENT")
  studyStatus      String    @default("CONTINUES")
  lessonsStopped   Boolean   @default(false)
  lessonsStoppedAt DateTime?
  coinBalance      Int       @default(0)
  branch           Branch    @relation(fields: [branchId], references: [id])
  student          User      @relation("StudentProfileUser", fields: [studentId], references: [id], onDelete: Cascade)
  teacher          User?     @relation("TeacherOfStudent", fields: [teacherId], references: [id])

  @@index([branchId])
  @@index([teacherId])
  @@map("student_profiles")
}

model CoinTransaction {
  id             String                @id @default(cuid())
  studentId      String
  amount         Int
  type           CoinTransactionType
  reason         String?
  source         CoinTransactionSource
  examAttemptId  String?
  rewardId       String?
  createdById    String?
  createdAt      DateTime              @default(now())

  student     User        @relation("StudentCoinTransactions", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation("CoinTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  examAttempt Attempt?    @relation(fields: [examAttemptId], references: [id], onDelete: SetNull)
  reward      CoinReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  @@unique([studentId, examAttemptId, type], name: "unique_student_exam_coin_type")
  @@index([studentId, createdAt])
  @@index([type, createdAt])
  @@index([rewardId])
  @@map("coin_transactions")
}

model CoinReward {
  id           String             @id @default(cuid())
  slug         String             @unique
  title        String
  description  String?
  coinCost     Int
  category     CoinRewardCategory
  icon         String             @default("🎁")
  isActive     Boolean            @default(true)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  transactions CoinTransaction[]

  @@index([isActive, sortOrder])
  @@map("coin_rewards")
}

model TeacherProfile {
  id          String    @id @default(cuid())
  teacherId   String    @unique
  phoneNumber String
  dateOfBirth DateTime?
  program     String?
  schedule    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  teacher     User      @relation("TeacherProfileUser", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@map("teacher_profiles")
}

model TuitionPayment {
  id        String        @id @default(cuid())
  studentId String
  branchId  String
  year      Int
  month     Int
  amount    Decimal       @db.Decimal(10, 2)
  status    PaymentStatus @default(UNPAID)
  paidAt    DateTime?
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  branch    Branch        @relation(fields: [branchId], references: [id])
  student   User          @relation("StudentTuitionPayments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, year, month])
  @@index([branchId, year, month])
  @@index([status, year, month])
  @@map("tuition_payments")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  BOSS
  BRANCH_ADMIN
  BRANCH_BOSS
  CREATOR
  PARENT
  PARTNER
}

enum ReferralStatus {
  IN_PROGRESS
  ACCEPTED
  DECLINED
}

enum CoinTransactionType {
  EARNED
  MANUAL_ADD
  MANUAL_DEDUCT
  REDEEMED
}

enum CoinTransactionSource {
  EXAM_SCORE
  ADMIN_ACTION
  REWARD_SHOP
}

enum CoinRewardCategory {
  DRINK
  FOOD
  DISCOUNT
  OTHER
}

model Referral {
  id               String         @id @default(cuid())
  partnerId        String
  branchId         String
  studentFirstName String
  studentLastName  String?
  studentEmail     String?
  studentPhone     String?
  program          String?
  notes            String?
  status           ReferralStatus @default(IN_PROGRESS)
  monthlyPrice     Decimal?       @db.Decimal(10, 2)
  commissionTiers  Json?
  studentId        String?
  decidedById      String?
  decidedAt        DateTime?
  decisionNotes    String?
  acceptedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  partner   User   @relation("PartnerReferrals", fields: [partnerId], references: [id], onDelete: Cascade)
  branch    Branch @relation("BranchReferrals", fields: [branchId], references: [id], onDelete: Restrict)
  decidedBy User?  @relation("ReferralDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  student   User?  @relation("StudentReferrals", fields: [studentId], references: [id], onDelete: SetNull)

  @@index([partnerId, status])
  @@index([branchId, status])
  @@index([studentId])
  @@map("referrals")
}

enum ExamCategory {
  IELTS
  TOEFL
  SAT
  KIDS
  GENERAL_ENGLISH
  MATH
}

enum SectionType {
  READING
  LISTENING
  WRITING
  SPEAKING
  GRAMMAR
  VOCABULARY
}

enum QuestionType {
  MCQ
  ORDER
  DND_MATCH
  TF
  MCQ_SINGLE
  MCQ_MULTI
  SELECT
  INLINE_SELECT
  GAP
  ORDER_SENTENCE
  DND_GAP
  SHORT_TEXT
  ESSAY
  TF_NG
  FILL_IN_BLANK
  SPEAKING_RECORDING
  IMAGE_INTERACTIVE
  HTML_CSS
}

enum PaymentStatus {
  PAID
  UNPAID
}

// === Lessons ===

enum LessonCategory {
  IELTS
  TOEFL
  SAT
  GENERAL_ENGLISH
  KIDS
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Lesson {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  category    LessonCategory
  level       String?
  summary     String?
  content     Json?
  coverImage  String?
  videoUrl    String?
  durationMin Int?
  order       Int              @default(0)
  isPublished Boolean          @default(false)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User?            @relation("LessonCreator", fields: [createdById], references: [id], onDelete: SetNull)
  progress    LessonProgress[]

  @@index([category, isPublished, order])
  @@index([createdById])
  @@map("lessons")
}

model LessonProgress {
  id           String               @id @default(cuid())
  lessonId     String
  studentId    String
  status       LessonProgressStatus @default(NOT_STARTED)
  progressPct  Int                  @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  lastViewedAt DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student      User                 @relation("StudentLessonProgress", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@index([studentId, status])
  @@map("lesson_progress")
}

// === Words ===

enum WordListCategory {
  GENERAL
  SAT
  IELTS
}

enum WordReviewStatus {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

model WordList {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  category    WordListCategory
  level       String?
  description String?
  isPublished Boolean          @default(false)
  order       Int              @default(0)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   User?            @relation("WordListCreator", fields: [createdById], references: [id], onDelete: SetNull)
  words       Word[]

  @@index([category, isPublished, order])
  @@index([createdById])
  @@map("word_lists")
}

model Word {
  id           String       @id @default(cuid())
  wordListId   String
  term         String
  definition   String
  partOfSpeech String?
  example      String?
  synonyms     String[]     @default([])
  audioUrl     String?
  imageUrl     String?
  order        Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  wordList     WordList     @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  reviews      WordReview[]

  @@index([wordListId, order])
  @@index([term])
  @@map("words")
}

model WordReview {
  id             String           @id @default(cuid())
  wordId         String
  studentId      String
  status         WordReviewStatus @default(NEW)
  correctCount   Int              @default(0)
  wrongCount     Int              @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  word           Word             @relation(fields: [wordId], references: [id], onDelete: Cascade)
  student        User             @relation("StudentWordReviews", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([wordId, studentId])
  @@index([studentId, status])
  @@index([studentId, nextReviewAt])
  @@map("word_reviews")
}

// === Tricks ===

enum TrickCategory {
  WRITING
  DESMOS
}

model Trick {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  category    TrickCategory
  summary     String?
  content     Json?
  coverImage  String?
  videoUrl    String?
  order       Int           @default(0)
  isPublished Boolean       @default(false)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User?         @relation("TrickCreator", fields: [createdById], references: [id], onDelete: SetNull)
  saves       TrickSave[]

  @@index([category, isPublished, order])
  @@index([createdById])
  @@map("tricks")
}

model TrickSave {
  id        String   @id @default(cuid())
  trickId   String
  studentId String
  createdAt DateTime @default(now())
  trick     Trick    @relation(fields: [trickId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentTrickSaves", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([trickId, studentId])
  @@index([studentId])
  @@map("trick_saves")
}

// === Teacher Schedule Dashboard ===

enum ScheduleDayType {
  ODD
  EVEN
}

enum LessonSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum HomeworkStatus {
  NOT_ASSIGNED
  ASSIGNED
  COMPLETED
  INCOMPLETE
  NOT_DONE
}

enum PerformanceRating {
  EXCELLENT
  GOOD
  AVERAGE
  WEAK
  DID_NOT_PARTICIPATE
}

// Recurring odd/even-day lesson template for a teacher.
model ScheduleSlot {
  id         String          @id @default(cuid())
  teacherId  String
  classId    String?
  branchId   String?
  dayType    ScheduleDayType
  title      String
  timeSlot   String
  hourlyRate Decimal?        @db.Decimal(10, 2)
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  teacher        User            @relation("TeacherScheduleSlots", fields: [teacherId], references: [id], onDelete: Cascade)
  class          Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lessonSessions LessonSession[]

  @@index([teacherId, dayType])
  @@index([classId])
  @@index([branchId])
  @@map("schedule_slots")
}

// A concrete lesson occurrence on a specific date.
model LessonSession {
  id             String              @id @default(cuid())
  teacherId      String
  classId        String?
  branchId       String?
  scheduleSlotId String?
  title          String
  date           DateTime            @db.Date
  timeSlot       String
  status         LessonSessionStatus @default(SCHEDULED)
  hourlyRate     Decimal?            @db.Decimal(10, 2)
  topic          String?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  teacher        User                  @relation("TeacherLessonSessions", fields: [teacherId], references: [id], onDelete: Cascade)
  class          Class?                @relation(fields: [classId], references: [id], onDelete: SetNull)
  branch         Branch?               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  scheduleSlot   ScheduleSlot?         @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  studentRecords LessonStudentRecord[]

  @@index([teacherId, date])
  @@index([classId, date])
  @@index([branchId, date])
  @@index([scheduleSlotId])
  @@map("lesson_sessions")
}

// Per-student record for a lesson: attendance, feedback, homework, behavior.
// Linked to student + lesson + class + teacher so parents can view it later.
model LessonStudentRecord {
  id              String           @id @default(cuid())
  lessonSessionId String
  studentId       String
  classId         String?
  teacherId       String
  attendance      AttendanceStatus  @default(PRESENT)
  lateMinutes     Int               @default(0)
  performance     PerformanceRating?
  homeworkStatus  HomeworkStatus    @default(NOT_ASSIGNED)
  feedback        String?
  teacherNote     String?
  behaviorNote    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  lessonSession LessonSession @relation(fields: [lessonSessionId], references: [id], onDelete: Cascade)
  student       User          @relation("StudentLessonRecords", fields: [studentId], references: [id], onDelete: Cascade)
  class         Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacher       User          @relation("TeacherLessonRecords", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([lessonSessionId, studentId])
  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
  @@index([classId])
  @@map("lesson_student_records")
}

// How a teacher is paid. Configured per teacher by a boss.
enum TeacherPayType {
  PER_LESSON
  HOURLY
  FIXED
}

// Per-teacher pay configuration used to estimate monthly salary.
model TeacherPaySetting {
  id          String         @id @default(cuid())
  teacherId   String         @unique
  payType     TeacherPayType @default(PER_LESSON)
  rate        Decimal?       @db.Decimal(10, 2) // per-lesson or hourly rate
  fixedAmount Decimal?       @db.Decimal(10, 2) // monthly amount when FIXED
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("teacher_pay_settings")
}

// Cached AI-generated weekly parent report for one student in one subject.
// Keyed by teacher + class + student + week so the same week isn't regenerated.
model WeeklyReport {
  id          String   @id @default(cuid())
  teacherId   String
  classId     String
  studentId   String
  weekStart   DateTime @db.Date
  subject     String
  studentName String
  text        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teacherId, classId, studentId, weekStart])
  @@index([teacherId, weekStart])
  @@map("weekly_reports")
}
